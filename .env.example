# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/aquapulse
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json
FIREBASE_DATABASE_URL=https://aquapulse-default-rtdb.firebaseio.com/

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@aquapulse.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Application Configuration
APP_NAME=AquaPulse
APP_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# Sampling Configuration
SAMPLING_INTERVAL_HOURS=3
DATA_RETENTION_DAYS=365

# Alert Configuration
ALERT_EMAIL_ENABLED=true
ALERT_SMS_ENABLED=true
ALERT_PUSH_ENABLED=true

# Report Configuration
REPORTS_DIR=./reports
TEMP_DIR=./temp

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5001
